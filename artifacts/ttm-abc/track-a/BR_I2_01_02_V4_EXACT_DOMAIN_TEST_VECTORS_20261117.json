{
  "schema": "ttm.track_a.br_i2_01_02.v4.mixed_frozen_v3_and_v4_domains.v1",
  "mode": "DESIGN_ONLY",
  "note": "SOURCE/DESIGN ONLY. SLOT, FINAL_KEY, SCOPE, PAYLOAD, CERT_TBS, PROVENANCE_TBS remain byte-exact V3 frozen to avoid a new science ledger ID. RELEASE_TBS and ENVELOPE have new V4 schema/tag. All synthetic hashes are not signatures or owner release.",
  "canon_policy": {
    "encoding": "US-ASCII strict subset of UTF-8, no BOM",
    "serialized_structure": "closed-schema JSON object sorted by ascending ASCII key bytes; compact commas/colons; true/false JSON; base-10 positive safe integers only; one terminal 0A",
    "duplicate_keys": "REJECT",
    "unknown_keys": "REJECT",
    "optional_keys": "NONE",
    "null": "REJECT",
    "float": "REJECT",
    "strings": "ASCII tokens only; no escapes, control characters or Unicode normalization",
    "raw_compare": "parsed typed object must reserialize byte-for-byte identically to raw input",
    "domain_format": "ASCII(TTM-A-BR-I2/)+ASCII(domain_version)+ASCII(/)+ASCII(kind)+00||C(closed_typed_object); frozen V3 and new V4 are type-specific, never inferred from caller metadata",
    "signature_preimage": "ASCII(TTM-A-BR-I2/)+ASCII(domain_version)+ASCII(/SIG/)+ASCII(kind)+ASCII(/)+ASCII(role)+00||C(TBS_obj); V3 for CERT/PROVENANCE, V4 for RELEASE; detached envelope explicitly declares tbs_wire_version",
    "hash": "Tagged SHA-256 over version-specific prefix||00||C(schema_object); raw file SHA-256 always SHA256(C(payload)) without prefix",
    "end_of_line": "exact one LF byte 0A, no CR"
  },
